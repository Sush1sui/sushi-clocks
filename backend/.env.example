# Server
PORT=8080
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:5173
BEHIND_PROXY=false

# Relational Database (Aiven PostgreSQL - Free Tier)
DATABASE_URL=postgres://avnadmin:your_password@your-aiven-pg-host:port/defaultdb?sslmode=require

# Telemetry & Audits (MongoDB Atlas M0 - Free Tier)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=sushi_clocks

# JWT Auth Security (OWASP A02/A05)
JWT_SECRET=super-secret-jwt-key-replace-with-random-32-chars-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Super Admin Initial Seeder
SUPER_ADMIN_EMAIL=superadmin@sushi-clocks.dev
SUPER_ADMIN_PASSWORD=SuperAdminPassword123!
SUPER_ADMIN_FIRST_NAME=Platform
SUPER_ADMIN_LAST_NAME=SuperAdmin
SUPER_ADMIN_MOBILE=
